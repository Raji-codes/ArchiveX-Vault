# AWS Configuration for ArchiveX Vault
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET=your-s3-bucket-name

# Optional: SQS & Lambda Configuration (from Terraform outputs)
AWS_SQS_QUEUE_URL=https://sqs.ap-southeast-2.amazonaws.com/123456789012/your-s3-bucket-name-ocr-queue
AWS_LAMBDA_FUNCTION_NAME=archivex-ocr-processor

# Application Port
PORT=3000
